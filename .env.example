# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_AUTH=neo4j/password
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_SERVER_NAME=simple-rag MCP Server
MCP_SERVER_DESCRIPTION=MCP server for personal knowledge management with Neo4j vector store
MCP_MAX_CONNECTIONS=100
MCP_KEEP_ALIVE_TIMEOUT=60

# Logging Configuration
LOG_LEVEL=INFO

# Application Configuration
APP_NAME=simple-rag
APP_VERSION=0.1.0
DEBUG=false

# Provider Selection
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# LLM Configuration
LLM_MODEL=qwen-rag
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=change_me
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# Embedding Configuration
EMBEDDING_MODEL=qwen3-embedding-cpu
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=change_me
EMBEDDING_DIMENSION=2560

# OpenAI Configuration (optional — used when provider is 'openai')
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=change_me
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_CTX=32768
OLLAMA_NUM_KEEP_ALIVE=30m
